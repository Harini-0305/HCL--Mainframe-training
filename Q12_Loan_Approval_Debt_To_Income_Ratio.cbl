IDENTIFICATION DIVISION.
PROGRAM-ID. LOAN12.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-MONTHLY-INCOME PIC 9(8).
01 WS-EXISTING-DEBT PIC 9(8).
01 WS-PROPOSED-PAYMENT PIC 9(8).

01 WS-TOTAL-OBLIGATIONS PIC 9(12) COMP-5.
01 WS-LEFT-VALUE PIC 9(12) COMP-5.
01 WS-RIGHT-VALUE PIC 9(12) COMP-5.

01 WS-RESULT PIC X(4).

PROCEDURE DIVISION.

MAIN-PARA.

    DISPLAY "================================"
    DISPLAY "      LOAN AFFORDABILITY CHECK"
    DISPLAY "================================"

    DISPLAY "ENTER MONTHLY INCOME:"
    ACCEPT WS-MONTHLY-INCOME

    DISPLAY "ENTER EXISTING MONTHLY DEBT:"
    ACCEPT WS-EXISTING-DEBT

    DISPLAY "ENTER PROPOSED LOAN PAYMENT:"
    ACCEPT WS-PROPOSED-PAYMENT

    COMPUTE WS-TOTAL-OBLIGATIONS =
       WS-EXISTING-DEBT + WS-PROPOSED-PAYMENT

    IF WS-MONTHLY-INCOME > ZERO

       COMPUTE WS-LEFT-VALUE =
          WS-TOTAL-OBLIGATIONS * 100

       COMPUTE WS-RIGHT-VALUE =
          WS-MONTHLY-INCOME * 35

       IF WS-LEFT-VALUE <= WS-RIGHT-VALUE

          MOVE 'PASS' TO WS-RESULT

       ELSE

          MOVE 'FAIL' TO WS-RESULT

       END-IF

    ELSE

       MOVE 'FAIL' TO WS-RESULT

    END-IF

    DISPLAY "--------------------------------"
    DISPLAY "MONTHLY INCOME: "
       WS-MONTHLY-INCOME

    DISPLAY "EXISTING DEBT: "
       WS-EXISTING-DEBT

    DISPLAY "PROPOSED PAYMENT: "
       WS-PROPOSED-PAYMENT

    DISPLAY "TOTAL OBLIGATIONS: "
       WS-TOTAL-OBLIGATIONS

    DISPLAY "RESULT: " WS-RESULT

    DISPLAY "================================"

    STOP RUN.
