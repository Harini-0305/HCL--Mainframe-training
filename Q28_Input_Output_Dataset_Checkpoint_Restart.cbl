
       >>SOURCE FORMAT FREE

IDENTIFICATION DIVISION.
PROGRAM-ID. CHECK28.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-TOTAL-RECORDS PIC 999 VALUE 5.
01 WS-CHECKPOINT PIC 999 VALUE 3.
01 WS-LAST-COMPLETED PIC 999 VALUE ZERO.
01 WS-RESTART-RECORD PIC 999 VALUE ZERO.

01 WS-PROCESSED-COUNT PIC 999 VALUE ZERO.
01 WS-SKIPPED-COUNT PIC 999 VALUE ZERO.

01 WS-I PIC 999 VALUE ZERO.
01 WS-INVALID-FLAG PIC X VALUE 'N'.

01 WS-RECORD-TABLE.
   05 WS-RECORD OCCURS 5 TIMES.
      10 WS-RECORD-ID PIC 999.
      10 WS-RECORD-DATA PIC X(10).

PROCEDURE DIVISION.

MAIN-PARA.

    PERFORM LOAD-RECORDS

    DISPLAY "=============================="
    DISPLAY " INPUT DATASET CONTROL REVIEW"
    DISPLAY "=============================="

    DISPLAY "TOTAL RECORDS: " WS-TOTAL-RECORDS
    DISPLAY "CHECKPOINT: " WS-CHECKPOINT

    PERFORM VALIDATE-CHECKPOINT

    IF WS-INVALID-FLAG = 'Y'

       DISPLAY "ERROR: INVALID CHECKPOINT"
       DISPLAY "RETURN CODE: 12"

       MOVE 12 TO RETURN-CODE
       STOP RUN

    END-IF

    IF WS-TOTAL-RECORDS = ZERO

       DISPLAY "INPUT DATASET IS EMPTY"
       DISPLAY "EMPTY FILE POLICY: COMPLETE"
       DISPLAY "RETURN CODE: 0"

       MOVE 0 TO RETURN-CODE
       STOP RUN

    END-IF

    COMPUTE WS-RESTART-RECORD =
       WS-CHECKPOINT + 1

    DISPLAY "RESTART FROM RECORD: "
       WS-RESTART-RECORD

    PERFORM PROCESS-RECORDS

    PERFORM DISPLAY-REPORT

    MOVE 0 TO RETURN-CODE

    STOP RUN.

LOAD-RECORDS.

    MOVE 1 TO WS-RECORD-ID(1)
    MOVE 'CUSTOMER01' TO WS-RECORD-DATA(1)

    MOVE 2 TO WS-RECORD-ID(2)
    MOVE 'CUSTOMER02' TO WS-RECORD-DATA(2)

    MOVE 3 TO WS-RECORD-ID(3)
    MOVE 'CUSTOMER03' TO WS-RECORD-DATA(3)

    MOVE 4 TO WS-RECORD-ID(4)
    MOVE 'CUSTOMER04' TO WS-RECORD-DATA(4)

    MOVE 5 TO WS-RECORD-ID(5)
    MOVE 'CUSTOMER05' TO WS-RECORD-DATA(5).

VALIDATE-CHECKPOINT.

    IF WS-CHECKPOINT > WS-TOTAL-RECORDS

       MOVE 'Y' TO WS-INVALID-FLAG

    ELSE

       IF WS-CHECKPOINT < ZERO

          MOVE 'Y' TO WS-INVALID-FLAG

       END-IF

    END-IF.

PROCESS-RECORDS.

    PERFORM VARYING WS-I FROM 1 BY 1
       UNTIL WS-I > WS-TOTAL-RECORDS

       IF WS-RECORD-ID(WS-I) <= WS-CHECKPOINT

          ADD 1 TO WS-SKIPPED-COUNT

          DISPLAY "RECORD "
             WS-RECORD-ID(WS-I)
             " ALREADY COMPLETED - SKIPPED"

       ELSE

          DISPLAY "PROCESSING RECORD: "
             WS-RECORD-ID(WS-I)

          DISPLAY "DATA: "
             WS-RECORD-DATA(WS-I)

          ADD 1 TO WS-PROCESSED-COUNT

          MOVE WS-RECORD-ID(WS-I)
             TO WS-LAST-COMPLETED

          DISPLAY "STATUS: SUCCESS"

       END-IF

    END-PERFORM.

DISPLAY-REPORT.

    DISPLAY "=============================="
    DISPLAY "       RESTART REPORT"
    DISPLAY "=============================="

    DISPLAY "SKIPPED RECORDS: "
       WS-SKIPPED-COUNT

    DISPLAY "PROCESSED RECORDS: "
       WS-PROCESSED-COUNT

    DISPLAY "LAST COMPLETED RECORD: "
       WS-LAST-COMPLETED

    DISPLAY "NEXT RESTART RECORD: "
       WS-LAST-COMPLETED + 1

    DISPLAY "RETURN CODE: 0"

    DISPLAY "BATCH COMPLETED".
