IDENTIFICATION DIVISION.
PROGRAM-ID. CUST19.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-CUSTOMER-ID-IN PIC X(256).
01 WS-CUSTOMER-NAME-IN PIC X(256).
01 WS-ACCOUNT-TYPE-IN PIC X(256).

01 WS-ID-LENGTH PIC 999 COMP-5.
01 WS-NAME-LENGTH PIC 999 COMP-5.
01 WS-TYPE-LENGTH PIC 999 COMP-5.

PROCEDURE DIVISION.

MAIN-PARA.

    DISPLAY "=============================="
    DISPLAY "    CUSTOMER RECORD FORMATTER"
    DISPLAY "=============================="

    DISPLAY "ENTER CUSTOMER ID:"
    ACCEPT WS-CUSTOMER-ID-IN

    DISPLAY "ENTER CUSTOMER NAME:"
    ACCEPT WS-CUSTOMER-NAME-IN

    DISPLAY "ENTER ACCOUNT TYPE:"
    ACCEPT WS-ACCOUNT-TYPE-IN

    COMPUTE WS-ID-LENGTH =
       FUNCTION LENGTH(
          FUNCTION TRIM(WS-CUSTOMER-ID-IN))

    COMPUTE WS-NAME-LENGTH =
       FUNCTION LENGTH(
          FUNCTION TRIM(WS-CUSTOMER-NAME-IN))

    COMPUTE WS-TYPE-LENGTH =
       FUNCTION LENGTH(
          FUNCTION TRIM(WS-ACCOUNT-TYPE-IN))

    IF WS-ID-LENGTH < 1 OR WS-ID-LENGTH > 12

       DISPLAY "ERROR: INVALID CUSTOMER ID LENGTH"

    ELSE

       IF WS-NAME-LENGTH < 1
          OR WS-NAME-LENGTH > 40

          DISPLAY "ERROR: INVALID CUSTOMER NAME LENGTH"

       ELSE

          IF WS-TYPE-LENGTH < 1
             OR WS-TYPE-LENGTH > 20

             DISPLAY "ERROR: INVALID ACCOUNT TYPE LENGTH"

          ELSE

             PERFORM DISPLAY-REPORT

          END-IF

       END-IF

    END-IF

    STOP RUN.

DISPLAY-REPORT.

    DISPLAY "=============================="
    DISPLAY "       CUSTOMER SUMMARY"
    DISPLAY "=============================="

    DISPLAY "Customer ID: "
       FUNCTION TRIM(WS-CUSTOMER-ID-IN)

    DISPLAY "Name: "
       FUNCTION TRIM(WS-CUSTOMER-NAME-IN)

    DISPLAY "Account Type: "
       FUNCTION TRIM(WS-ACCOUNT-TYPE-IN)

    DISPLAY "==============================".
