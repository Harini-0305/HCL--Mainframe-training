
       >>SOURCE FORMAT FREE

IDENTIFICATION DIVISION.
PROGRAM-ID. FRAUD25.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-TOTAL-RECORDS PIC 99 VALUE 8.

01 WS-TRANSACTION-TABLE.
   05 WS-TRANSACTION OCCURS 8 TIMES.
      10 WS-ACTUAL-LABEL PIC X(5).
      10 WS-PREDICTION PIC X(5).

01 WS-I PIC 99.

01 WS-TP PIC 999 VALUE ZERO.
01 WS-FP PIC 999 VALUE ZERO.
01 WS-TN PIC 999 VALUE ZERO.
01 WS-FN PIC 999 VALUE ZERO.

01 WS-PRECISION PIC 999V99 VALUE ZERO.
01 WS-RECALL PIC 999V99 VALUE ZERO.

01 WS-PREDICTED-POSITIVES PIC 999 VALUE ZERO.
01 WS-ACTUAL-FRAUD PIC 999 VALUE ZERO.

01 WS-PRECISION-OUT PIC ZZ9.99.
01 WS-RECALL-OUT PIC ZZ9.99.

PROCEDURE DIVISION.

MAIN-PARA.

    PERFORM LOAD-TEST-DATA

    DISPLAY "================================"
    DISPLAY " FRAUD DETECTION EVALUATION"
    DISPLAY "================================"

    PERFORM VARYING WS-I FROM 1 BY 1
       UNTIL WS-I > WS-TOTAL-RECORDS

       PERFORM PROCESS-RECORD

    END-PERFORM

    PERFORM CALCULATE-METRICS

    PERFORM DISPLAY-RESULTS

    STOP RUN.

LOAD-TEST-DATA.

    MOVE 'FRAUD' TO WS-ACTUAL-LABEL(1)
    MOVE 'FLAG' TO WS-PREDICTION(1)

    MOVE 'LEGIT' TO WS-ACTUAL-LABEL(2)
    MOVE 'FLAG' TO WS-PREDICTION(2)

    MOVE 'LEGIT' TO WS-ACTUAL-LABEL(3)
    MOVE 'CLEAR' TO WS-PREDICTION(3)

    MOVE 'FRAUD' TO WS-ACTUAL-LABEL(4)
    MOVE 'CLEAR' TO WS-PREDICTION(4)

    MOVE 'FRAUD' TO WS-ACTUAL-LABEL(5)
    MOVE 'FLAG' TO WS-PREDICTION(5)

    MOVE 'LEGIT' TO WS-ACTUAL-LABEL(6)
    MOVE 'CLEAR' TO WS-PREDICTION(6)

    MOVE 'FRAUD' TO WS-ACTUAL-LABEL(7)
    MOVE 'FLAG' TO WS-PREDICTION(7)

    MOVE 'LEGIT' TO WS-ACTUAL-LABEL(8)
    MOVE 'FLAG' TO WS-PREDICTION(8).

PROCESS-RECORD.

    DISPLAY "--------------------------------"

    DISPLAY "ACTUAL: "
       WS-ACTUAL-LABEL(WS-I)

    DISPLAY "PREDICTION: "
       WS-PREDICTION(WS-I)

    EVALUATE TRUE

       WHEN WS-ACTUAL-LABEL(WS-I) = 'FRAUD'
        AND WS-PREDICTION(WS-I) = 'FLAG'

          ADD 1 TO WS-TP
          DISPLAY "RESULT: TRUE POSITIVE"

       WHEN WS-ACTUAL-LABEL(WS-I) = 'LEGIT'
        AND WS-PREDICTION(WS-I) = 'FLAG'

          ADD 1 TO WS-FP
          DISPLAY "RESULT: FALSE POSITIVE"

       WHEN WS-ACTUAL-LABEL(WS-I) = 'LEGIT'
        AND WS-PREDICTION(WS-I) = 'CLEAR'

          ADD 1 TO WS-TN
          DISPLAY "RESULT: TRUE NEGATIVE"

       WHEN WS-ACTUAL-LABEL(WS-I) = 'FRAUD'
        AND WS-PREDICTION(WS-I) = 'CLEAR'

          ADD 1 TO WS-FN
          DISPLAY "RESULT: FALSE NEGATIVE"

       WHEN OTHER

          DISPLAY "INVALID INPUT RECORD"

    END-EVALUATE.

CALCULATE-METRICS.

    COMPUTE WS-PREDICTED-POSITIVES =
       WS-TP + WS-FP

    COMPUTE WS-ACTUAL-FRAUD =
       WS-TP + WS-FN

    IF WS-PREDICTED-POSITIVES > ZERO

       COMPUTE WS-PRECISION ROUNDED =
          (WS-TP / WS-PREDICTED-POSITIVES)
          * 100

    ELSE

       MOVE ZERO TO WS-PRECISION

       DISPLAY "NO PREDICTED POSITIVES"

    END-IF

    IF WS-ACTUAL-FRAUD > ZERO

       COMPUTE WS-RECALL ROUNDED =
          (WS-TP / WS-ACTUAL-FRAUD) * 100

    ELSE

       MOVE ZERO TO WS-RECALL

       DISPLAY "NO ACTUAL FRAUD RECORDS"

    END-IF.

DISPLAY-RESULTS.

    MOVE WS-PRECISION TO WS-PRECISION-OUT
    MOVE WS-RECALL TO WS-RECALL-OUT

    DISPLAY "================================"
    DISPLAY " CONFUSION MATRIX"
    DISPLAY "================================"

    DISPLAY "TRUE POSITIVE: " WS-TP
    DISPLAY "FALSE POSITIVE: " WS-FP
    DISPLAY "TRUE NEGATIVE: " WS-TN
    DISPLAY "FALSE NEGATIVE: " WS-FN

    DISPLAY "--------------------------------"

    DISPLAY "PRECISION: " WS-PRECISION-OUT "%"

    DISPLAY "RECALL: " WS-RECALL-OUT "%"

    DISPLAY "================================"
    DISPLAY "PROCESSING COMPLETED".

