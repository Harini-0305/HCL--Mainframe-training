
//REORGJOB JOB (ACCT),'VSAM REORG',CLASS=A,MSGCLASS=X
//STEP1    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//KSDSIN   DD DISP=SHR,DSN=PROD.CUST.KSDS
//SEQBAK   DD DISP=OLD,DSN=PROD.CUST.SEQBAK
//KSDSOUT  DD DISP=OLD,DSN=PROD.CUST.KSDS
//SYSIN    DD *
  REPRO INFILE(KSDSIN) OUTFILE(SEQBAK)

  DELETE PROD.CUST.KSDS CLUSTER PURGE

  DEFINE CLUSTER ( -
    NAME(PROD.CUST.KSDS) -
    INDEXED -
    KEYS(10 0) -
    RECORDSIZE(200 200) -
    FREESPACE(20 10) -
  )

  REPRO INFILE(SEQBAK) OUTFILE(KSDSOUT)
/*
