IDENTIFICATION DIVISION.
PROGRAM-ID. LEDGER19.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-OPENING-BALANCE PIC 9(7)V99 VALUE 100.00.
01 WS-CURRENT-BALANCE PIC 9(7)V99 VALUE ZERO.

01 WS-TOTAL-CREDIT PIC 9(7)V99 VALUE ZERO.
01 WS-TOTAL-DEBIT PIC 9(7)V99 VALUE ZERO.

01 WS-EXPECTED-BALANCE PIC 9(7)V99 VALUE ZERO.

01 WS-POSTED-COUNT PIC 99 VALUE ZERO.
01 WS-REJECTED-COUNT PIC 99 VALUE ZERO.

01 WS-TXN-COUNT PIC 99 VALUE 8.
01 WS-I PIC 99.

01 WS-TRANSACTION-TABLE.
   05 WS-TRANSACTION OCCURS 8 TIMES.
      10 WS-TXN-TYPE PIC X.
      10 WS-TXN-AMOUNT PIC 9(7)V99.

01 WS-BALANCE-OUT PIC Z,ZZZ,ZZ9.99.
01 WS-CREDIT-OUT PIC Z,ZZZ,ZZ9.99.
01 WS-DEBIT-OUT PIC Z,ZZZ,ZZ9.99.
01 WS-AMOUNT-OUT PIC Z,ZZZ,ZZ9.99.

PROCEDURE DIVISION.

MAIN-PARA.

    MOVE WS-OPENING-BALANCE
      TO WS-CURRENT-BALANCE

    DISPLAY "================================"
    DISPLAY "       CREDIT DEBIT LEDGER"
    DISPLAY "================================"

    DISPLAY "OPENING BALANCE: 100.00"

    PERFORM LOAD-TRANSACTIONS

    PERFORM VARYING WS-I FROM 1 BY 1
       UNTIL WS-I > WS-TXN-COUNT

       PERFORM PROCESS-TRANSACTION

    END-PERFORM

    PERFORM DISPLAY-SUMMARY

    PERFORM CHECK-INVARIANT

    STOP RUN.

LOAD-TRANSACTIONS.

    MOVE 'D' TO WS-TXN-TYPE(1)
    MOVE 40.00 TO WS-TXN-AMOUNT(1)

    MOVE 'D' TO WS-TXN-TYPE(2)
    MOVE 80.00 TO WS-TXN-AMOUNT(2)

    MOVE 'C' TO WS-TXN-TYPE(3)
    MOVE 25.00 TO WS-TXN-AMOUNT(3)

    MOVE 'D' TO WS-TXN-TYPE(4)
    MOVE 10.00 TO WS-TXN-AMOUNT(4)

    MOVE 'D' TO WS-TXN-TYPE(5)
    MOVE 0.00 TO WS-TXN-AMOUNT(5)

    MOVE 'X' TO WS-TXN-TYPE(6)
    MOVE 15.00 TO WS-TXN-AMOUNT(6)

    MOVE 'D' TO WS-TXN-TYPE(7)
    MOVE 20.00 TO WS-TXN-AMOUNT(7)

    MOVE 'D' TO WS-TXN-TYPE(8)
    MOVE 20.00 TO WS-TXN-AMOUNT(8).

PROCESS-TRANSACTION.

    MOVE WS-TXN-AMOUNT(WS-I)
      TO WS-AMOUNT-OUT

    DISPLAY "--------------------------------"

    DISPLAY "TRANSACTION NUMBER: " WS-I

    DISPLAY "TYPE: " WS-TXN-TYPE(WS-I)

    DISPLAY "AMOUNT: " WS-AMOUNT-OUT

    IF WS-TXN-AMOUNT(WS-I) = ZERO

       DISPLAY "STATUS: REJECTED - ZERO AMOUNT"

       ADD 1 TO WS-REJECTED-COUNT

    ELSE

       EVALUATE WS-TXN-TYPE(WS-I)

          WHEN 'C'

             ADD WS-TXN-AMOUNT(WS-I)
               TO WS-CURRENT-BALANCE

             ADD WS-TXN-AMOUNT(WS-I)
               TO WS-TOTAL-CREDIT

             ADD 1 TO WS-POSTED-COUNT

             DISPLAY "STATUS: POSTED"

          WHEN 'D'

             IF WS-TXN-AMOUNT(WS-I)
                 <= WS-CURRENT-BALANCE

                SUBTRACT WS-TXN-AMOUNT(WS-I)
                  FROM WS-CURRENT-BALANCE

                ADD WS-TXN-AMOUNT(WS-I)
                  TO WS-TOTAL-DEBIT

                ADD 1 TO WS-POSTED-COUNT

                DISPLAY "STATUS: POSTED"

             ELSE

                DISPLAY "STATUS: REJECTED -"
                        " INSUFFICIENT BALANCE"

                ADD 1 TO WS-REJECTED-COUNT

             END-IF

          WHEN OTHER

             DISPLAY "STATUS: REJECTED -"
                     " INVALID TRANSACTION TYPE"

             ADD 1 TO WS-REJECTED-COUNT

       END-EVALUATE

    END-IF

    MOVE WS-CURRENT-BALANCE TO WS-BALANCE-OUT

    DISPLAY "CURRENT BALANCE: " WS-BALANCE-OUT.

DISPLAY-SUMMARY.

    DISPLAY "================================"
    DISPLAY "       FINAL LEDGER REPORT"
    DISPLAY "================================"

    MOVE WS-CURRENT-BALANCE TO WS-BALANCE-OUT
    MOVE WS-TOTAL-CREDIT TO WS-CREDIT-OUT
    MOVE WS-TOTAL-DEBIT TO WS-DEBIT-OUT

    DISPLAY "OPENING BALANCE: 100.00"

    DISPLAY "TOTAL CREDIT: " WS-CREDIT-OUT

    DISPLAY "TOTAL DEBIT: " WS-DEBIT-OUT

    DISPLAY "FINAL BALANCE: " WS-BALANCE-OUT

    DISPLAY "POSTED COUNT: " WS-POSTED-COUNT

    DISPLAY "REJECTED COUNT: " WS-REJECTED-COUNT

    DISPLAY "================================".

CHECK-INVARIANT.

    COMPUTE WS-EXPECTED-BALANCE =
       WS-OPENING-BALANCE
       + WS-TOTAL-CREDIT
       - WS-TOTAL-DEBIT

    IF WS-CURRENT-BALANCE = WS-EXPECTED-BALANCE

       DISPLAY "LEDGER INVARIANT: PASSED"

    ELSE

       DISPLAY "LEDGER INVARIANT: FAILED"

    END-IF

    DISPLAY "BATCH PROCESSING COMPLETED".
