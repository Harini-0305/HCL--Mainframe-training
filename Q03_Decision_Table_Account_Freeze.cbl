IDENTIFICATION DIVISION.
PROGRAM-ID. ACCOUNT3.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-TOTAL-TESTS PIC 99 VALUE 8.
01 WS-I PIC 99 VALUE ZERO.

01 WS-DECISION-TABLE.
   05 WS-TEST OCCURS 8 TIMES.
      10 WS-ACCOUNT-STATUS PIC X.
      10 WS-KYC-FLAG PIC X.
      10 WS-FRAUD-HOLD PIC X.

01 WS-RESULT PIC X(5).

01 WS-ALLOW-COUNT PIC 99 VALUE ZERO.
01 WS-BLOCK-COUNT PIC 99 VALUE ZERO.

PROCEDURE DIVISION.

MAIN-PARA.

    PERFORM LOAD-TEST-DATA

    DISPLAY "================================"
    DISPLAY " ACCOUNT FREEZE EVALUATION"
    DISPLAY "================================"

    PERFORM VARYING WS-I FROM 1 BY 1
       UNTIL WS-I > WS-TOTAL-TESTS

       PERFORM CHECK-ACCOUNT

    END-PERFORM

    DISPLAY "================================"
    DISPLAY "       FINAL REPORT"
    DISPLAY "================================"

    DISPLAY "TOTAL TESTS: " WS-TOTAL-TESTS
    DISPLAY "ALLOW COUNT: " WS-ALLOW-COUNT
    DISPLAY "BLOCK COUNT: " WS-BLOCK-COUNT

    DISPLAY "PROCESSING COMPLETED"

    STOP RUN.

LOAD-TEST-DATA.

    MOVE 'A' TO WS-ACCOUNT-STATUS(1)
    MOVE 'Y' TO WS-KYC-FLAG(1)
    MOVE 'N' TO WS-FRAUD-HOLD(1)

    MOVE 'A' TO WS-ACCOUNT-STATUS(2)
    MOVE 'Y' TO WS-KYC-FLAG(2)
    MOVE 'Y' TO WS-FRAUD-HOLD(2)

    MOVE 'A' TO WS-ACCOUNT-STATUS(3)
    MOVE 'N' TO WS-KYC-FLAG(3)
    MOVE 'N' TO WS-FRAUD-HOLD(3)

    MOVE 'A' TO WS-ACCOUNT-STATUS(4)
    MOVE 'N' TO WS-KYC-FLAG(4)
    MOVE 'Y' TO WS-FRAUD-HOLD(4)

    MOVE 'I' TO WS-ACCOUNT-STATUS(5)
    MOVE 'Y' TO WS-KYC-FLAG(5)
    MOVE 'N' TO WS-FRAUD-HOLD(5)

    MOVE 'I' TO WS-ACCOUNT-STATUS(6)
    MOVE 'Y' TO WS-KYC-FLAG(6)
    MOVE 'Y' TO WS-FRAUD-HOLD(6)

    MOVE 'I' TO WS-ACCOUNT-STATUS(7)
    MOVE 'N' TO WS-KYC-FLAG(7)
    MOVE 'N' TO WS-FRAUD-HOLD(7)

    MOVE 'I' TO WS-ACCOUNT-STATUS(8)
    MOVE 'N' TO WS-KYC-FLAG(8)
    MOVE 'Y' TO WS-FRAUD-HOLD(8).

CHECK-ACCOUNT.

    DISPLAY "--------------------------------"

    DISPLAY "TEST NUMBER: " WS-I

    DISPLAY "ACCOUNT STATUS: "
       WS-ACCOUNT-STATUS(WS-I)

    DISPLAY "KYC FLAG: "
       WS-KYC-FLAG(WS-I)

    DISPLAY "FRAUD HOLD: "
       WS-FRAUD-HOLD(WS-I)

    IF WS-ACCOUNT-STATUS(WS-I) = 'A'
       AND WS-KYC-FLAG(WS-I) = 'Y'
       AND WS-FRAUD-HOLD(WS-I) = 'N'

       MOVE 'ALLOW' TO WS-RESULT

       ADD 1 TO WS-ALLOW-COUNT

    ELSE

       MOVE 'BLOCK' TO WS-RESULT

       ADD 1 TO WS-BLOCK-COUNT

    END-IF

    DISPLAY "WITHDRAWAL RESULT: " WS-RESULT.
